# Copy to .env.local for local development. Every variable below is optional —
# the app runs with none of them set (see README "Environment variables").
# Never commit a real .env / .env.local file.

# Enables direct browser -> Vercel Blob uploads via /api/upload-token,
# bypassing the platform's ~4.5MB serverless request-body limit for larger
# PDFs. Set automatically when a Blob store is attached to the Vercel
# project; without it, uploads fall back to posting the file directly to
# /api/inspect (works for files under the body-size limit, and is how local
# dev runs by default).
BLOB_READ_WRITE_TOKEN=
