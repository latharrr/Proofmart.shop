# Copy to .env.local for local development.
# Never commit a real .env / .env.local file.

# --- Supabase (auth + database) ---
# Required for sign up / sign in / sign out / password reset and anything
# that reads or writes the database. From the Supabase dashboard -> your
# project -> Settings -> API. Safe to expose to the browser (that's what
# NEXT_PUBLIC_ means here) — Supabase's security model is Row Level
# Security policies on the database, not keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sign in with Google (via Supabase Auth) ---
# Configured entirely in the Supabase dashboard (Authentication -> Providers
# -> Google), not as env vars in this app. You still need a Google Cloud
# OAuth client (Console -> APIs & Services -> Credentials -> OAuth client ID
# -> Web application), but its Authorized redirect URI must point at
# Supabase's own callback, not this app's:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# Paste that Google Client ID + Secret into the Supabase provider settings.
# Without this configured, email+password sign-in still works — only the
# "Continue with Google" button errors.

# --- Everything below is optional; the app runs with none of it set ---

# Enables direct browser -> Vercel Blob uploads via /api/upload-token,
# bypassing the platform's ~4.5MB serverless request-body limit for larger
# PDFs. Without it, uploads fall back to posting the file directly to
# /api/inspect (works for files under the body-size limit, and is how local
# dev runs by default).
#
# IMPORTANT — the Blob store backing this MUST be created as "Private", not
# "Public" (Vercel dashboard: Storage tab -> Create Database -> Blob ->
# Private). Public/private is a property of the store itself, chosen once at
# creation — not something this app's code can select per upload. A Public
# store would mean uploaded PDFs (real financial documents) are reachable by
# anyone who obtains the URL during the brief upload->process window.
#
# Set automatically when a Blob store is connected to this Vercel project
# (or use OIDC instead: BLOB_STORE_ID + VERCEL_OIDC_TOKEN, Vercel's
# recommended approach — see README).
BLOB_READ_WRITE_TOKEN=

# Required for /api/upload-token's presigned-upload flow to work AT ALL
# (checked unconditionally by the SDK's handleUploadPresigned, even though
# this app doesn't use upload-completion webhooks). Provisioned alongside
# BLOB_READ_WRITE_TOKEN when you connect a Blob store to this project via
# the standard "Connect to Project" flow; if an older/manually-created
# connection is missing it, add it from the store's connection menu.
BLOB_WEBHOOK_PUBLIC_KEY=
